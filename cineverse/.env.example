# TMDB API (required for movies)
VITE_TMDB_TOKEN=your_tmdb_api_read_access_token_here

# Supabase (required for backend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# NOTE: the service role key is never used in the app. Deploy it to Edge Functions only:
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Google Books (required for books)
VITE_GOOGLE_BOOKS_KEY=your_google_books_api_key_here

# Paystack (required for payments)
VITE_PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here
# Paystack secret key (server-side, used by Edge Function webhook)
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
